# Supabase (공유 DB). 미설정 시 데모(localStorage) 모드로 동작.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# 데모 모드 전용 접근 코드(클라이언트 검증). Supabase 모드에서는 보안에 미사용.
NEXT_PUBLIC_ADMIN_PASSCODE=demo-only

# 서버 전용(클라이언트 비노출) — Supabase 모드의 실제 관리자 인증.
# ADMIN_PASSCODE 는 DB app_config.admin_passcode 와 동일해야 함.
ADMIN_PASSCODE=change-me
# 세션 쿠키 서명용 무작위 시크릿: `openssl rand -hex 32`
ADMIN_SESSION_SECRET=replace-with-random-hex

# 예매 오픈 알림 메일 (네이버 SMTP)
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=your_id@naver.com
SMTP_PASS=naver-application-password   # 로그인 비번 아님, '애플리케이션 비밀번호'
NOTIFY_TO=eksska12@naver.com

# Vercel Cron 보호용 시크릿
CRON_SECRET=replace-with-random-hex
